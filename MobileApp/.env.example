# Copy to .env in this folder and fill in your keys.
# https://aistudio.google.com/apikey

GEMINI_API_KEY=your_auth_key_here
GEMINI_MODEL=gemini-flash-latest

# Optional: override the OCR backend base URL per platform.
# Example: http://192.168.1.23:5000
OCR_BACKEND_URL_ANDROID=
OCR_BACKEND_URL_IOS=
